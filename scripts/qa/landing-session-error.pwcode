// Local browser regression for Task 3.11.8; not real Telegram/auth delivery QA.
async (page) => {
  const baseUrl = page.url().match(/^https?:\/\/[^/]+/)?.[0]
  if (!baseUrl?.startsWith('http://127.0.0.1:')) throw new Error('Local QA only')
  const errors = []
  const appErrors = []
  let requests = 0
  const onError = (error) => errors.push(error.message)
  const onConsole = (message) => {
    if (message.type() === 'error' && /FetchError|Unhandled|Uncaught/i.test(message.text())) appErrors.push(message.text())
  }
  page.on('pageerror', onError)
  page.on('console', onConsole)
  await page.unrouteAll({ behavior: 'ignoreErrors' })
  await page.route('**/api/auth/get-session', (route) => {
    requests++
    return route.fulfill({ status: 503, contentType: 'application/json', body: JSON.stringify({ message: 'Local QA session unavailable' }) })
  })
  try {
    await page.goto(baseUrl)
    await page.waitForLoadState('networkidle')
    const href = await page.locator('.landing__header-cta').getAttribute('href')
    if (requests === 0) throw new Error('Session failure fixture was not used')
    if (href !== '/auth/login?redirect=%2Fm%2Forgs%2Fcreate') throw new Error('Session error lost anonymous CTA')
    if (errors.length || appErrors.length) throw new Error(`Unhandled application failure: ${JSON.stringify({ errors, appErrors })}`)
    const faq = page.locator('.landing__faq details').first()
    await faq.locator('summary').press('Enter')
    if (!(await faq.evaluate((node) => node.open))) throw new Error('FAQ failed after session error')
    await page.locator('.landing__header-cta').click()
    await page.waitForURL('**/auth/login?redirect=%2Fm%2Forgs%2Fcreate')
    return { errors, appErrors, requests, href, faq: 'passed', loginRedirect: 'passed' }
  } finally {
    page.off('pageerror', onError)
    page.off('console', onConsole)
    await page.unrouteAll({ behavior: 'ignoreErrors' })
    await page.goto(baseUrl)
  }
}
