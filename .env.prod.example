# Production secrets (скопировать в .env на VPS, chmod 600)
DOMAIN=volleytime.by

# Database
DB_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEBHOOK_SECRET_PATH=
WEBHOOK_SECRET_TOKEN=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://volleytime.by

# Bot internal
BOT_INTERNAL_SECRET=
WEB_URL=https://volleytime.by

# Email (console до подключения провайдера)
EMAIL_DRIVER=console

# Monitoring (Phase 9.6)
SENTRY_DSN_WEB=
SENTRY_DSN_BOT=

# Rate limit входа (Task 9.9.11)
# за Caddy: доверяем последнему элементу X-Forwarded-For (Task 9.10.1)
TRUSTED_PROXY=1
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000

# Backups (Phase 9.7)
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=21

# Images (CI/CD)
WEB_IMAGE=volleytime-web:latest
BOT_IMAGE=volleytime-bot:latest
MIGRATOR_IMAGE=volleytime-migrator:latest

# Smoke после деплоя (Task 9.9.2): отдельный Telegram-аккаунт для проверки входа
SMOKE_TG_ID=
# Проверка бэкапов (Task 9.9.9)
BACKUP_AGE_RECIPIENT=
HEALTHCHECK_URL=

# ВАЖНО (Task 9.9.5): значения выше compose пробрасывает в web как NUXT_*,
# иначе Nuxt их не увидит (runtimeConfig читает только NUXT_*).
